# Telegram API credentials (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Channel username (without @)
TELEGRAM_CHANNEL=thetickeriseth

# Session string (auto-saved after first login, do not edit)
TELEGRAM_SESSION=

# Cloudflare R2 for Telegram image hosting (optional — uploads skipped if unset)
# Create an R2 bucket, enable public access (custom domain or *.r2.dev), and an
# API token with Object Read & Write. R2_PUBLIC_BASE_URL has no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# RapidAPI Twitter 수집 (twitter-api45) — 미설정 시 트위터 수집만 자동 스킵
X_RAPIDAPI_KEY=
# X_RAPIDAPI_HOST=twitter-api45.p.rapidapi.com  # 기본값이라 보통 생략

# 코인니스 텔레그램 채널 (기본값 coinnesskr — 보통 생략)
# COINNESS_CHANNEL=coinnesskr

# Privy (https://dashboard.privy.io)
VITE_PRIVY_APP_ID=

# Thirdweb (https://thirdweb.com/dashboard)
VITE_THIRDWEB_CLIENT_ID=
VITE_BADGE_CONTRACT_ADDRESS_BASE=
VITE_BADGE_CONTRACT_ADDRESS_ETH=

# Research publishing (Vercel serverless)
PUBLISH_PASSWORD=
GITHUB_PAT=
GITHUB_REPO_OWNER=sumsun-dev
GITHUB_REPO_NAME=The-Ticker-is-ETH
